# Base URL of the backend API (must be prefixed with NEXT_PUBLIC_ to reach the browser).
# Locally you can set it to /api instead: this site's own server then passes API calls on to
# the backend (API_PROXY_TARGET, default http://localhost:5000) — needed when opening the site
# through a dev tunnel or from a phone, where "localhost" isn't your computer.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public URL of this site (used for metadata / OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cinematic homepage hero video (optional). Set a URL (e.g. Cloudinary) OR drop
# a file at frontend/public/hero.mp4. If neither exists, the hero shows the
# poster image instead. Keep it short, muted-friendly and compressed (<~8MB).
NEXT_PUBLIC_HERO_VIDEO_URL=

# Contact (shown on the site)
NEXT_PUBLIC_CONTACT_EMAIL=info@darkmusicyard.com
NEXT_PUBLIC_MANAGEMENT_EMAIL=info@darkmusicyard.com
# WhatsApp number, digits only incl. country code (e.g. 233XXXXXXXXX). Leave blank to hide.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Streaming + social (leave blank until you have them)
NEXT_PUBLIC_SPOTIFY_URL=
NEXT_PUBLIC_APPLE_MUSIC_URL=
# DMY's channel (music videos) — defaults to youtube.com/@darkmusicyard
NEXT_PUBLIC_YOUTUBE_URL=
# Lenko Psycho's own channel (the Follow icons) — defaults to youtube.com/@lenkopsycho
NEXT_PUBLIC_LENKO_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
